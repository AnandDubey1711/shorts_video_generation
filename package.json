{
  "name": "reel_generator",
  "version": "1.0.0",
  "description": "Reddit stories to YouTube Shorts",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "migrate": "knex migrate:latest",
    "setup": "bash setup.sh",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:restart": "pm2 restart shorts-video-generation",
    "pm2:stop": "pm2 stop shorts-video-generation",
    "pm2:logs": "pm2 logs shorts-video-generation"
  },
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@googleapis/youtube": "^35.0.0",
    "bullmq": "^6.5.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "ioredis": "^6.0.0",
    "knex": "^3.3.0",
    "pg": "^8.23.1",
    "undici": "^6.29.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  },
  "nodemonConfig": {
    "watch": [
      "src"
    ],
    "ext": "js,txt"
  }
}
