# Sample config for local development. Copy it and fill in the secrets:
#   cp .env.development .env
# setup.sh does this copy for you if .env is missing. Never commit the real .env.

# --- server -------------------------------------------------------------------
PORT=3000

# --- postgres (setup.sh can create the role + database for you) ----------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=reels
DB_USER=reels
DB_PASSWORD=change-me

# --- redis (bullmq queue) -----------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# --- stories ------------------------------------------------------------------
# comma-separated, no "r/"
REDDIT_SUBREDDITS=AmItheAsshole
# posts per arctic-shift request, and how many pages back to go per fetch
REDDIT_PAGE_SIZE=100
REDDIT_MAX_PAGES=5
# post body length limits (characters); outside this range is skipped
REDDIT_MIN_CHARS=800
REDDIT_MAX_CHARS=4000
# reels created per POST /reels/fetch
STORIES_PER_FETCH=3
ARCTIC_SHIFT_URL=https://arctic-shift.photon-reddit.com
# when set, stories come from this file instead of arctic-shift (handy offline); comment out for real data
REDDIT_MOCK_FILE=./mock/stories.json

# --- llm (ollama) -------------------------------------------------------------
OLLAMA_URL=http://localhost:11434
# local alias the app calls; setup.sh creates it with `ollama cp OLLAMA_SOURCE_MODEL OLLAMA_MODEL`
OLLAMA_MODEL=qwen-reel
# Q4_K_M quantized Qwen 8B (~2.8 GB), fits on 8 GB RAM machines
# https://huggingface.co/Anand1711/qwen_8b_quantized_model
OLLAMA_SOURCE_MODEL=hf.co/Anand1711/qwen_8b_quantized_model:Q4_K_M
# word-count limits for the generated story; outside them the script step fails
MIN_WORDS=200
MAX_WORDS=400

# --- voice (kokoro tts server) ------------------------------------------------
KOKORO_URL=http://localhost:8880
KOKORO_DIR=/path/to/kokoro
# git url to clone into KOKORO_DIR if it doesn't exist yet
KOKORO_REPO=
KOKORO_VOICE_FEMALE=af_heart
KOKORO_VOICE_MALE=am_adam
KOKORO_SPEED=1

# --- captions (whisper.cpp for word timing) -----------------------------------
# must end in build/bin/whisper-cli; setup.sh clones + builds it if missing
WHISPER_BIN=/path/to/whisper.cpp/build/bin/whisper-cli
# setup.sh downloads this file by name from huggingface.co/ggerganov/whisper.cpp if missing
WHISPER_MODEL=/path/to/whisper.cpp/models/ggml-base.en-q5_1.bin
WORDS_PER_CAPTION=3
# any font installed on the system (fc-list)
CAPTION_FONT=DejaVu Sans
CAPTION_SIZE=90

# --- media --------------------------------------------------------------------
# background clips go in ASMR_DIR; the rest are outputs (created on startup)
ASMR_DIR=./media/asmr
AUDIO_DIR=./media/audio
SUBS_DIR=./media/subs
VIDEO_DIR=./media/reels
# narration longer than this fails the render step
MAX_SECONDS=59

# --- youtube ------------------------------------------------------------------
# google cloud console -> oauth client (web application), youtube data api v3 enabled
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REDIRECT_URI=http://localhost:3000/auth/youtube/callback
YT_TOKEN_PATH=./youtube-token.json
# private | unlisted | public
YT_PRIVACY=private
